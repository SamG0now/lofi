{
  "name": "lo-fi",
  "productName": "Lo-fi",
  "version": "2.1.0",
  "description": "Mini Spotify player with visualizations.",
  "homepage": "http://lofi.rocks",
  "desktopName": "lo-fi.desktop",
  "main": "./pack/main.bundle.js",
  "scripts": {
    "install": "pnpm run build",
    "config-xcode": "node-gyp configure -- -f xcode",
    "build": "node-gyp rebuild && genversion --es6 --semi version.generated.ts",
    "start": "electron ./pack/main.bundle.js --ozone-platform=x11",
    "dev": "pnpm run development",
    "development": "rimraf pack && webpack --watch --config ./webpack.dev.js --progress --color",
    "production": "rimraf pack && webpack --config ./webpack.prod.js --progress --color",
    "pack": "pnpm run build && pnpm run production && rimraf dist && electron-builder --dir",
    "dist": "pnpm run build && pnpm run production && rimraf dist && electron-builder",
    "dist:win": "bash scripts/windows/build.sh",
    "clean": "rimraf build && rimraf pack && rimraf dist",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prepare": "husky install"
  },
  "repository": "https://github.com/SamG0now/lofi.git",
  "author": "David Titarenco <david.titarenco@gmail.com>",
  "license": "MIT",
  "private": true,
  "build": {
    "files": [
      "./pack/**/*",
      "./icon.*",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "appId": "lo-fi.rocks",
    "mac": {
      "identity": null,
      "category": "music.player"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Audio",
      "icon": "icon.png",
      "synopsis": "Mini Spotify player with visualizations.",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  },
  "devDependencies": {
    "@types/lodash": "^4.14.168",
    "@types/node": "^24.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^5.28.0",
    "@typescript-eslint/parser": "^5.28.0",
    "copy-pkg-json-webpack-plugin": "^0.0.40",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^5.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^7.32.0 || ^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "file-loader": "^6.2.0",
    "genversion": "^3.0.1",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^8.0.3",
    "native-ext-loader": "^2.3.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "style-loader": "^2.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-permissions-plugin": "^1.0.9"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mantine/core": "^6.0.10",
    "@mantine/hooks": "^6.0.10",
    "bindings": "^1.3.1",
    "dayjs": "^1.11.7",
    "electron-store": "^8.1.0",
    "electron-util": "^0.17.2",
    "lodash": "^4.17.21",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-hook-form": "^7.41.2",
    "styled-components": "^5.3.6",
    "zod": "^3.22.3"
  }
}
